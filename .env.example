# ---- 生产基础设施（docker compose up -d 一次起全栈）----
# Qdrant 6333 | OpenSearch 9200 | Neo4j 7474/7687
# 改造进度见 docs/production-upgrade.md

# 向量库：chroma=CI/离线（默认）| qdrant=生产
# 物理分库：collection / index 名 = kb_id（policies / tabular / pdf）
VECTOR_BACKEND=chroma
QDRANT_URL=http://localhost:6333
# 遗留统一库名；reset 时会删除；正常入库使用 per-kb collection
QDRANT_COLLECTION=corpus

# Phase 2 OpenSearch BM25；物理分库时 index = kb_id
BM25_BACKEND=pkl
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=corpus

# Graph RAG（第 11 周代码接入；基础设施已就绪）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
# compose 用，格式 neo4j/密码，须与 NEO4J_PASSWORD 一致
NEO4J_AUTH=neo4j/changeme
# 通用图入库和 GraphPlan 规划；关闭时显式失败，不回退旧领域规则
GRAPH_LLM_EXTRACT=true
GRAPH_QUERY_PLANNER=true

# ---- LLM 网关：通义千问 / DashScope / 阿里云 MaaS（OpenAI 兼容协议）----
# base_url 指向兼容模式地址；业务代码无需改，只配这里即可。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型分级：强模型做难推理，便宜模型做简单任务
CHAT_MODEL_STRONG=qwen-max
CHAT_MODEL_CHEAP=qwen-turbo
# 按你的网关填写。DashScope 常用 text-embedding-v3；部分 MaaS 为 qwen*-text-embedding
EMBEDDING_MODEL=text-embedding-v3

# ---- 可靠性参数 ----
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=4

# ---- 可观测性：Langfuse（Week 2）----
# 从 cloud.langfuse.com 或自建实例获取；BASE_URL 与 HOST 填一即可
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- 重排（Week 3）：cross-encoder；RERANK_ENABLED=false 可关闭 ----
# 模型较大；国内建议先用 ModelScope 下载：
#   uv run python -c "from modelscope import snapshot_download; print(snapshot_download('BAAI/bge-reranker-base'))"
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-base
# macOS MPS 下 CrossEncoder 可能 native crash；生产默认固定 CPU
RERANK_DEVICE=cpu

# ---- 拒答 / 检索置信度（rerank 时亦用于过滤全部候选 chunk）----
REFUSE_MIN_RERANK_SCORE=0.15
REFUSE_MIN_VECTOR_SCORE=0.35

# ---- 检索增强：默认关闭 ----
QUERY_DECOMPOSE_ENABLED=false
PARENT_EXPAND_ENABLED=false

# ---- Chroma（VECTOR_BACKEND=chroma 时使用）----
CHROMA_PATH=./data/chroma/unified

# ---- 知识库父目录（其下每个含 markdown/html/csv 的子目录都会统一入库）----
CORPUS_DIR=./data/corpus
